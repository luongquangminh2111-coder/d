		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.WalkSpeed ~= customWalkSpeed then
			hum.WalkSpeed = customWalkSpeed
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if mainFrame.Visible then
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local pPos = player.Character.HumanoidRootPart.Position
			playerCoordLabel.Text = string.format("X: %.2f\nY: %.2f\nZ: %.2f", pPos.X, pPos.Y, pPos.Z)
		end
	end

	if flying and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local cam = workspace.CurrentCamera
		local velocity = Vector3.new(0, 0, 0)
		local currentSpeed = keysDown.Shift and (flySpeed * 2) or flySpeed

		local look = cam.CFrame.LookVector
		local right = cam.CFrame.RightVector

		if keysDown.W then velocity = velocity + look end
		if keysDown.S then velocity = velocity - look end
		if keysDown.A then velocity = velocity - right end
		if keysDown.D then velocity = velocity + right end
		if keysDown.Space then velocity = velocity + Vector3.new(0, 1, 0) end

		if bodyVel and bodyGyro then
			bodyVel.Velocity = velocity.Unit.Magnitude > 0 and (velocity.Unit * currentSpeed) or Vector3.new(0, 0, 0)
			bodyGyro.CFrame = cam.CFrame
		end
	end

	if airWalking and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum and airWalkVel then
			local moveDir = hum.MoveDirection
			local speed = hum.WalkSpeed
			airWalkVel.Velocity = Vector3.new(moveDir.X * speed, 0, moveDir.Z * speed)
		end
	end

	if waterWalking and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = player.Character.HumanoidRootPart
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum and waterWalkVel and waterWalkGyro and waterWalkVel.Parent == hrp then
			local moveDir = hum.MoveDirection
			local speed = hum.WalkSpeed
			
			local currentPos = hrp.Position
			local targetY = -0.49
			local yDiff = targetY - currentPos.Y
			local yVel = yDiff * 25
			
			waterWalkVel.Velocity = Vector3.new(moveDir.X * speed, yVel, moveDir.Z * speed)
			
			if moveDir.Magnitude > 0 then
				waterWalkGyro.CFrame = CFrame.new(currentPos, currentPos + moveDir)
			end
		end
	end
end)

-- LOGIC AUTO RANDOM FRUIT v2 (ZIOLES' GACHA BOX)
-- Sửa lỗi:
-- 1) Nhận diện trái bằng Tool.ToolTip == "Blox Fruit" / con "Fruit" / thuộc tính OriginalName (tên Tool không nhất thiết có chữ "Fruit"
--    nên bản cũ không bao giờ thấy trái mới -> báo "chưa mua được" rồi lặp lại).
-- 2) Xác nhận mua bằng trái mới HOẶC Beli giảm (Auto Store có thể cất trái đi trước khi kịp đếm).
-- 3) Kết quả không xác nhận chỉ chờ 5 phút thử lại, không khoá 2 giờ như khi mua thành công.
-- 4) Remote bị từ chối -> tự bay tới NPC Zioles (Blox Fruit Gacha), mở Gacha Box và bấm nút mua như người chơi thật.
-- 5) Ghi trạng thái từng bước vào _G.RandomFruitStatus (hiện trên tab Gacha) để biết chính xác đang kẹt ở đâu.
task.spawn(function()
    local RF_DEBUG            = true
    local RF_COOLDOWN         = 7200 + 30
    local RF_RETRY            = 60      -- remote + UI đều thất bại rõ ràng
    local RF_RETRY_UNCONFIRMED = 300    -- server trả về nhưng không thấy trái/Beli đổi

    local nextBuyAt   = 0
    local wasEnabled  = false

    _G.RandomFruitStatus = "Đang tắt"

    local function setStatus(...)
        local parts = {}
        for i = 1, select("#", ...) do parts[#parts + 1] = tostring((select(i, ...))) end
        _G.RandomFruitStatus = table.concat(parts, " ")
        if RF_DEBUG then print("[RandomFruit]", _G.RandomFruitStatus) end
    end

    local function getCommF()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF and commF:IsA("RemoteFunction") then return commF end
        return nil
    end

    local function getBeli()
        local data = LocalPlayer:FindFirstChild("Data")
        local beli = data and data:FindFirstChild("Beli")
        return beli and tonumber(beli.Value) or nil
    end

    -- Dùng chung cho Auto Store Fruit
    _G.IsFruitTool = function(tool)
        if not tool or not tool:IsA("Tool") then return false end
        if tool.ToolTip == "Blox Fruit" then return true end
        if tool:FindFirstChild("Fruit") ~= nil then return true end
        if tool:GetAttribute("Fruit") ~= nil or tool:GetAttribute("OriginalName") ~= nil then return true end
        return string.find(string.lower(tool.Name), "fruit", 1, true) ~= nil
    end

    -- Snapshot: số lượng theo tên Tool (Backpack + đang cầm)
    local function snapshotFruitTools()
        local snap = {}
        local function scan(container)
            if not container then return end
            for _, tool in ipairs(container:GetChildren()) do
                if _G.IsFruitTool(tool) then snap[tool.Name] = (snap[tool.Name] or 0) + 1 end
            end
        end
        scan(LocalPlayer:FindFirstChild("Backpack"))
        scan(LocalPlayer.Character)
        return snap
    end

    local function describe(v)
        if type(v) == "table" then
            local parts = {}
            for k, val in pairs(v) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(val) end
            return "{" .. table.concat(parts, ", ") .. "}"
        end
        return tostring(v)
    end

    -- Có trái mới hoặc Beli giảm so với trước khi mua?
    local function purchaseConfirmed(beliBefore, snapBefore)
        local beliNow = getBeli()
        if beliBefore and beliNow and beliNow < beliBefore then
            return true, "Beli giảm " .. tostring(beliBefore - beliNow)
        end
        for name, n in pairs(snapshotFruitTools()) do
            if n > (snapBefore[name] or 0) then return true, "Nhận trái: " .. name end
        end
        return false
    end

    local function waitConfirm(beliBefore, snapBefore, seconds)
        local deadline = tick() + seconds
        repeat
            local ok, why = purchaseConfirmed(beliBefore, snapBefore)
            if ok then return true, why end
            task.wait(0.25)
        until tick() >= deadline
        return false
    end

    -- ===== CÁCH 1: REMOTE (không cần bay) =====
    local function tryRemote()
        local commF = getCommF()
        if not commF then return "fail", "Không thấy Remotes.CommF_" end

        local beliBefore, snapBefore = getBeli(), snapshotFruitTools()

        local okC, resC = pcall(function() return commF:InvokeServer("Cousin", "Check") end)
        setStatus("Remote Check:", okC and describe(resC) or ("LỖI " .. tostring(resC)))
        task.wait(0.3)

        local okB, resB = pcall(function() return commF:InvokeServer("Cousin", "Buy") end)
        if not okB then return "fail", "Remote Buy lỗi: " .. tostring(resB) end
        setStatus("Remote Buy trả về:", describe(resB))

        local ok, why = waitConfirm(beliBefore, snapBefore, 4)
        if ok then return "success", why end
        return "unconfirmed", "Buy trả về " .. describe(resB) .. " nhưng không thấy trái/Beli đổi"
    end

    -- ===== CÁCH 2: GIAO DIỆN (bay tới Zioles, bấm nút như người chơi) =====
    local function guiVisible(obj, playerGui)
        local g = obj
        while g and g ~= playerGui do
            if g:IsA("GuiObject") and not g.Visible then return false end
            if g:IsA("ScreenGui") and not g.Enabled then return false end
            g = g.Parent
        end
        return true
    end

    local function buttonText(btn)
        local t = ""
        pcall(function()
            if btn:IsA("TextButton") then t = btn.Text end
            for _, d in ipairs(btn:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then t = t .. " " .. d.Text end
            end
        end)
        return string.lower(t)
    end

    -- Tìm nút đang hiện theo hàm điều kiện
    local function findButton(pred)
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return nil end
        for _, d in ipairs(pg:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiVisible(d, pg) and pred(d) then
                return d
            end
        end
        return nil
    end

    -- Bấm nút bằng chuột ảo (giống click thật); dự phòng firesignal
    local function clickButton(btn)
        local done = false
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local inset = game:GetService("GuiService"):GetGuiInset()
            local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2

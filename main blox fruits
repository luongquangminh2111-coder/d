    local function findGachaNPC()
        local npcs = workspace:FindFirstChild("NPCs")
        local function match(inst)
            local n = string.lower(inst.Name)
            return inst:IsA("Model") and (string.find(n, "gacha", 1, true) or string.find(n, "zioles", 1, true))
        end
        if npcs then
            for _, d in ipairs(npcs:GetDescendants()) do
                if match(d) then return d end
            end
        end
        for _, d in ipairs(workspace:GetDescendants()) do
            if match(d) then return d end
        end
        return nil
    end

    local function tryUI()

function Q.normMob(n)
    local s = string.lower(tostring(n))
    s = string.gsub(s, "%s*%[.-%]%s*$", "")
    s = string.gsub(s, "possessed", "posessed")
    return s
end

-- 2 = trùng tên hoàn toàn, 1 = tên chứa tên quest, 0 = không khớp
function Q.mobMatches(enemyName, questMob)
    if not questMob then return 0 end
    local a, b = Q.normMob(enemyName), Q.normMob(questMob)
    if a == b then return 2 end
    if string.find(a, b, 1, true) then return 1 end
    return 0
end

-- Fishman Island (Sea 1), Cursed Ship (Sea 2) và Submerged Island (Sea 3)
-- cần bước vào bằng remote đặc biệt. Với Submerged Island, script tự
-- tới khu Submarine Worker ở Tiki Outpost rồi gọi "TravelToSubmergedIsland"
-- (tương đương bấm Yes trong hộp thoại).
function Q.enterIfNeeded(hrp, pos)
    if not hrp or not pos then return false end

    -- =========================================================
    -- SEA 3: SUBMERGED ISLAND
    -- Level 2600+ phải nói chuyện với Submarine Worker ở Tiki Outpost,
    -- sau đó gọi đúng RemoteFunction RF/SubmarineWorkerSpeak.
    -- Chỉ trả về false khi đã xác nhận nhân vật thật sự ở dưới nước.
    -- =========================================================
    if World3 and pos.Y < -1000 then
        local function getRoot()
            local char = LocalPlayer.Character
            return char and char:FindFirstChild("HumanoidRootPart")
        end

        local function isInsideSubmerged()
            local root = getRoot()
            if not root then return false end

            -- Dùng chính vùng quest dưới nước làm vùng xác nhận,
            -- tránh coi Tiki Outpost là đã vào Submerged.
            local p = root.Position
            local questCenter = Vector3.new(10480, -2050, 9800)
            local dx = p.X - questCenter.X
            local dz = p.Z - questCenter.Z
            return p.Y < -1000 and (dx * dx + dz * dz) <= (4300 * 4300)
        end

        if isInsideSubmerged() then
            submergedTravelBusy = false
            submergedTravelAttempts = 0
            return false
        end

        -- Trong lúc NPC/remote đang xử lý thì tuyệt đối không cho Auto Level
        -- bay tiếp tới mob dưới nước.
        if submergedTravelBusy then
            if tick() - submergedTravelLast < 10 then
                return true
            end
            submergedTravelBusy = false
        end

        -- Chống gọi remote liên tục.
        if tick() - submergedTravelLast < 1.25 then
            return true
        end

        submergedTravelLast = tick()
        submergedTravelAttempts = submergedTravelAttempts + 1
        submergedTravelBusy = true

        -- Vị trí dự phòng của Submarine Worker ở Tiki Outpost.
        local workerPos = SUBMERGED_WORKER_POS
        local worker = nil

        pcall(function()
            worker = workspace:FindFirstChild("Submarine Worker", true)
            if worker then
                if worker:IsA("BasePart") then
                    workerPos = worker.Position
                else
                    local ok, cf = pcall(function() return worker:GetPivot() end)
                    if ok and cf then
                        workerPos = cf.Position
                    end
                end
            end
        end)

        Q.qlog("Submerged: tới Submarine Worker, lần " .. tostring(submergedTravelAttempts))

        local root = getRoot()
        if not root then
            submergedTravelBusy = false
            return true
        end

        -- Đưa người chơi tới gần NPC trước khi mở hội thoại.
        if (root.Position - workerPos).Magnitude > 18 then
            pcall(function()
                flyTo(CFrame.new(workerPos + Vector3.new(0, 3, 0)), math.max(flySpeed, 220), function()
                    return autoFarmEnabled and LocalPlayer.Character ~= nil
                end)
            end)
            task.wait(0.2)
        end

        -- Cập nhật root sau khi di chuyển vì Character/HRP có thể vừa thay đổi.
        root = getRoot()
        if not root then
            submergedTravelBusy = false
            return true
        end

        -- =========================================================
        -- ĐÚNG REMOTE CỦA SUBMARINE WORKER
        -- ReplicatedStorage.RF.SubmarineWorkerSpeak
        -- =========================================================
        local invoked = false
        local result = nil

        local okFind = pcall(function()
            local rfFolder = ReplicatedStorage:FindFirstChild("RF")
            local rf = rfFolder and rfFolder:FindFirstChild("SubmarineWorkerSpeak")

            if rf and rf:IsA("RemoteFunction") then
                local okInvoke, ret = pcall(function()
                    return rf:InvokeServer("TravelToSubmergedIsland")
                end)
                if okInvoke then
                    invoked = true
                    result = ret
                end
            end
        end)

        -- Một số bản map có thể đặt remote trực tiếp ở ReplicatedStorage.
        if not invoked then
            pcall(function()
                local rf = ReplicatedStorage:FindFirstChild("SubmarineWorkerSpeak")
                if rf and rf:IsA("RemoteFunction") then
                    local okInvoke, ret = pcall(function()
                        return rf:InvokeServer("TravelToSubmergedIsland")
                    end)
                    if okInvoke then
                        invoked = true
                        result = ret
                    end
                end
            end)
        end

        -- Fallback cuối: nếu remote chưa xuất hiện nhưng NPC có ProximityPrompt,
        -- kích hoạt prompt để mở đúng hội thoại NPC. Không tự teleport mù.
        if not invoked and worker then
            pcall(function()
                local prompt = worker:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and typeof(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt)
                end
            end)
        end

        if not invoked then
            Q.qlog("Submerged: chưa gọi được RF/SubmarineWorkerSpeak; sẽ thử lại")
            submergedTravelBusy = false
            return true
        end

        Q.qlog("Submerged: gọi TravelToSubmergedIsland thành công", result)

        -- Remote có thể trả về trước khi Character được chuyển map/vị trí.
        -- Chờ tối đa 10 giây và chỉ cho farm tiếp khi xác nhận Y < -1000.
        local deadline = tick() + 10
        while tick() < deadline do
            task.wait(0.2)
            if isInsideSubmerged() then
                submergedTravelBusy = false
                submergedTravelAttempts = 0
                Q.qlog("Submerged: xác nhận đã xuống đảo dưới nước")
                return false
            end
        end

        submergedTravelBusy = false
        Q.qlog("Submerged: remote đã chạy nhưng chưa xác nhận vị trí, sẽ thử lại")
        return true
    end

    -- Sea 1 / Sea 2
    local commF = getCommF()
    if not commF then return false end
    local entrance
    if World1 and pos.X > 50000 and hrp.Position.X < 50000 then
        entrance = Vector3.new(61163.8515625, 5.342342376708252, 1819.7841796875)
    elseif World2 and pos.Z > 30000 and hrp.Position.Z < 30000 then
        entrance = Vector3.new(923.21252441406, 126.9760055542, 32852.83203125)
    end
    if not entrance then return false end
    if tick() - (Q.lastEntrance or 0) < 6 then return false end
    Q.lastEntrance = tick()
    Q.qlog("requestEntrance ->", entrance)
    pcall(function() commF:InvokeServer("requestEntrance", entrance) end)
    task.wait(1)
    return true
end

